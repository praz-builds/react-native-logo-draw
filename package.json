{
  "name": "react-native-logo-draw",
  "version": "0.1.0",
  "description": "Animate any SVG path being drawn on like a pen tracing it, then filled. Plus a CLI that generates a correct Expo app-icon set. Zero runtime dependencies, built-in Animated only, iOS + Android + web.",
  "keywords": [
    "react-native",
    "expo",
    "react-native-web",
    "svg",
    "svg-animation",
    "svg-path",
    "path-animation",
    "animation",
    "animated-svg",
    "logo",
    "logo-animation",
    "draw",
    "drawing-animation",
    "stroke",
    "stroke-dasharray",
    "strokeDashoffset",
    "signature",
    "handwriting",
    "splash-screen",
    "brand",
    "ios",
    "android",
    "typescript",
    "app-icon",
    "app-icons",
    "adaptive-icon",
    "android-adaptive-icon",
    "notification-icon",
    "favicon",
    "icon-generator",
    "expo-icons",
    "png"
  ],
  "license": "MIT",
  "author": "Prasanna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/praz-builds/react-native-logo-draw.git"
  },
  "bugs": {
    "url": "https://github.com/praz-builds/react-native-logo-draw/issues"
  },
  "homepage": "https://github.com/praz-builds/react-native-logo-draw#readme",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "react-native-logo-draw": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:cli",
    "build:lib": "rimraf dist && tsc -p tsconfig.build.json",
    "build:cli": "node scripts/build-cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.68.0",
    "react-native-svg": ">=13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "^0.81.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.18",
    "@types/react-test-renderer": "^19.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "opentype.js": "^1.3.4",
    "polygon-clipping": "^0.15.7",
    "react": "^19.1.0",
    "react-native": "^0.81.4",
    "react-native-svg": "^15.12.1",
    "react-test-renderer": "^19.1.0",
    "rimraf": "^6.1.3",
    "svgpath": "^2.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
